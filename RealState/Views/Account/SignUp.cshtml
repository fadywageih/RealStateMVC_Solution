@model SignUpViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<form  asp-action="SignUp" method="post" class="space-y-5">
    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

    <div>
        <label asp-for="FirstName" class="block text-sm font-medium text-gray-700">First Name</label>
        <input asp-for="FirstName"  type="text" id="FirstName" required
               class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition" />
        <span asp-validation-for="FirstName" class="text-red-500 text-sm mt-1"></span>
    </div>
    <div>
        <label asp-for=LastName class="block text-sm font-medium text-gray-700">Last Name</label>
        <input asp-for="LastName" type="text" id="FirstName" required
               class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition" />
        <span asp-validation-for="LastName" class="text-red-500 text-sm mt-1"></span>
    </div>
    <div>
        <label asp-for="UserName" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <input asp-for="UserName" 
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition" required />
        <span asp-validation-for="UserName" class="text-red-500 text-xs mt-1 block"></span>
    </div>
    <div>
        <label asp-for=Email class="block text-sm font-medium text-gray-700">Email Address</label>
        <input asp-for="Email" type="email" id="Email" required
               class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition" />
        <span asp-validation-for="Email" class="text-red-500 text-sm mt-1"></span>
    </div>

    <div>
        <label asp-for="Password" class="block text-sm font-medium text-gray-700">Password</label>
        <input asp-for="Password" type="password" id="Password" required
               class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition" />
        <span asp-validation-for="Password" class="text-red-500 text-sm mt-1"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" required
               class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition" />
        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm mt-1"></span>
    </div>
    <div class="flex items-start">
        <input asp-for="IsAgree" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded mt-1" required />
        <label asp-for="IsAgree" class="ml-2 block text-sm text-gray-700">
            I agree to the <a href="#" class="text-primary hover:underline">terms of service</a>
        </label>
    </div>
    <button type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-md transition duration-200">
        Create Account
    </button>

</form>

<div class="mt-6 text-center">
    <p class="text-gray-600">
        Already have an account?
        <a asp-controller="Account" asp-action="SignIn" class="text-blue-600 hover:underline font-medium">Sign in</a>
    </p>
</div>


@section validationScripts {
    <partial name="_ValidationScriptsPartial" />
}