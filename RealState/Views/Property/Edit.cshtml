@using RealState.BLL.Services.Property
@model UpdatedPropertyDto
@{
    ViewData["Title"] = "Edit Property";
}

<div class="max-w-3xl mx-auto bg-white p-6 rounded-xl shadow-md mt-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Edit Property</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="Title" class="block text-sm font-medium text-gray-700">Title</label>
                <input asp-for="Title" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" />
                <span asp-validation-for="Title" class="text-red-500 text-sm"></span>
            </div>
            <div>
                <label asp-for="City" class="block text-sm font-medium text-gray-700">City</label>
                <input asp-for="City" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" />
                <span asp-validation-for="City" class="text-red-500 text-sm"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="block text-sm font-medium text-gray-700">Description</label>
            <textarea asp-for="Description" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="PriceType" class="block text-sm font-medium text-gray-700">Price Type</label>
                <select asp-for="PriceType" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
                    <option value="Fixed">Fixed</option>
                    <option value="Negotiable">Negotiable</option>
                </select>
                <span asp-validation-for="PriceType" class="text-red-500 text-sm"></span>
            </div>
            <div>
                <label asp-for="Price" class="block text-sm font-medium text-gray-700">Price (Optional)</label>
                <input asp-for="Price" type="number" step="0.01" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" />
                <span asp-validation-for="Price" class="text-red-500 text-sm"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="PropertyType" class="block text-sm font-medium text-gray-700">Property Type</label>
                <select asp-for="PropertyType" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md">
                    <option value="Apartment">Apartment</option>
                    <option value="Villa">Villa</option>
                    <option value="Building">Building</option>
                    <option value="Land">Land</option>
                </select>
                <span asp-validation-for="PropertyType" class="text-red-500 text-sm"></span>
            </div>
            <div>
                <label asp-for="ContactPhone" class="block text-sm font-medium text-gray-700">Contact Phone (Optional)</label>
                <input asp-for="ContactPhone" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md" />
                <span asp-validation-for="ContactPhone" class="text-red-500 text-sm"></span>
            </div>
        </div>

        <!-- ✅ استخدم ViewBag -->
        @if (ViewBag.CurrentImages != null && ((List<dynamic>)ViewBag.CurrentImages).Count > 0)
        {
            <div class="mb-6">
                <h3 class="text-sm font-medium text-gray-700 mb-2">Current Images</h3>
                <div class="grid grid-cols-3 gap-2">
                    @foreach (var img in (List<dynamic>)ViewBag.CurrentImages)
                    {
                        <div class="relative">
                            <img src="@img.Url" alt="Property Image" class="w-full h-24 object-cover rounded" />
                            <label class="flex items-center mt-1">
                                <input type="checkbox" name="ImagesToDelete" value="@img.Id" class="mr-1" />
                                <span class="text-xs text-red-600">Delete</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
        <!-- رفع صور جديدة -->
        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Add New Images (Optional)</label>
            <input asp-for="NewImages" type="file" multiple accept="image/*"
                   class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-600 file:text-white hover:file:bg-green-700" />
            <p class="mt-1 text-xs text-gray-500">You can select multiple images.</p>
            <span asp-validation-for="NewImages" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-action="MyOffers" class="px-4 py-2 text-gray-700 bg-gray-200 rounded-md hover:bg-gray-300">Cancel</a>
            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700">Update Property</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}