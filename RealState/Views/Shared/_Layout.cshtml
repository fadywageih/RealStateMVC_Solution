<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealState</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* إصلاح مسافة الزر في الموبايل */
        .menu-toggle {
            margin-top: 2px;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <header class="bg-white shadow-sm">
        <nav class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <!-- Logo -->
                <a class="text-xl font-bold text-green-700 hover:text-blue-900"
                   asp-area="" asp-controller="Home" asp-action="Index">RealState</a>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-6">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="flex items-center space-x-4">
                            <span class="text-gray-600 font-medium hidden lg:inline">Welcome, @User.Identity.Name</span>
                            <a class="text-gray-700 hover:text-blue-600 font-medium" asp-controller="Property" asp-action="Index">Offers</a>
                            <a class="text-gray-700 hover:text-blue-600 font-medium" asp-controller="Property" asp-action="MyOffers">My Offers</a>
                            <a class="text-green-600 hover:text-green-800 font-medium" asp-controller="Account" asp-action="Settings">Settings</a>
                            <a class="text-red-600 hover:text-red-800 font-medium" asp-controller="Account" asp-action="SignOut"
                               asp-route-returnUrl="@Url.Action("Index", "Home")">Logout</a>
                        </div>
                    }
                    else
                    {
                        <a class="text-blue-600 hover:text-blue-800 font-medium" asp-controller="Account" asp-action="SignIn">Login</a>
                    }
                </div>

                <!-- Mobile Menu Button -->
                <button id="menu-toggle" class="md:hidden text-gray-700 focus:outline-none menu-toggle">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            <!-- Mobile Menu (Initially hidden) -->
            <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="space-y-3">
                        <div class="text-gray-600 font-medium px-4">Welcome, @User.Identity.Name</div>
                        <a class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-md" asp-controller="Property" asp-action="Index">Offers</a>
                        <a class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-md" asp-controller="Property" asp-action="MyOffers">My Offers</a>
                        <a class="block px-4 py-2 text-green-600 hover:bg-gray-100 rounded-md" asp-controller="Account" asp-action="Settings">Settings</a>
                        <a class="block px-4 py-2 text-red-600 hover:bg-gray-100 rounded-md" asp-controller="Account" asp-action="SignOut"
                           asp-route-returnUrl="@Url.Action("Index", "Home")">Logout</a>
                    </div>
                }
                else
                {
                    <a class="block px-4 py-2 text-blue-600 hover:bg-gray-100 rounded-md" asp-controller="Account" asp-action="SignIn">Login</a>
                }
            </div>
        </nav>
    </header>

    <main class="container mx-auto px-4 py-6 flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-gray-100 border-t mt-auto">
        <div class="container mx-auto px-4 py-4 text-center text-gray-600 text-sm">
            &copy; 2025 - RealState
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Toggle Mobile Menu
        document.getElementById('menu-toggle').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });
    </script>
</body>
</html>